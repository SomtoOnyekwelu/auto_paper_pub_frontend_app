---
// CHALLENGE SPACE: Layout — per-journal CSS variable injection +
// AMSSRN org logo + head slot (Tasks 1 + 4 of the refinement set)
// PURPOSE: HTML shell, per-journal :root CSS injection, named head
//   slot for SeoHead.astro, AMSSRN org logo header.
// INCLUSION: shell, :root injection, head slot, AMSSRN logo.
// EXCLUSION: Highwire meta contents (SeoHead).
// DEPENDENCY: lib/themes.
import "../styles/global.css";
import { getTheme, DEFAULT_THEME, type Theme } from "../lib/themes";
import { orgLogoUrl, PUBLIC_ASSET_PREFIX } from "../config/brand";

interface Props {
  journalInitials?: string;
  title: string;
  description?: string;
}

const props = Astro.props;
const theme: Theme =
  props.journalInitials ? getTheme(props.journalInitials) : DEFAULT_THEME;
// NO astro base (2026-08-12): pages live at src/pages/journals/* so routes are
// /journals/*. Bundled CSS/JS are prefixed by build.assetsPrefix (which must
// equal PUBLIC_ASSET_PREFIX). public/ assets (favicon, logo) are NOT covered by
// assetsPrefix, so they are derived from the same PUBLIC_ASSET_PREFIX single
// source of truth; public/_redirects 200-rewrites /journals/assets/* ->
// /assets/* (and /journals/favicon.svg -> /favicon.svg). Canonical = site +
// pathname (Astro.url.pathname already carries /journals/ from the route).
const faviconHref = PUBLIC_ASSET_PREFIX + "/favicon.svg";
const canonicalHref = Astro.site
  ? new URL(Astro.url.pathname, Astro.site).href
  : Astro.url.href;
const orgLogoHref = orgLogoUrl;

function toCssVarDecls(vars: Record<string, string>) {
  return Object.entries(vars)
    .map(([k, v]) => k + ":" + v + ";")
    .join(" ");
}
const cssVarsCss =
  ":root { " + toCssVarDecls(theme.css_variables) + " }";

---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href={faviconHref} />
    <link rel="canonical" href={canonicalHref} />
    <title set:html={props.title} />
    {props.description && (
      <meta name="description" content={props.description} />
    )}
    <style is:inline set:html={cssVarsCss} />
    <slot name="head" />
</head>
  <body class="min-h-screen bg-white text-gray-900 font-sans antialiased">
    <header class="max-w-3xl mx-auto px-6 pt-6 pb-2">
      <a href="/journals/" aria-label="AMSSRN — Journals">
        <img src={orgLogoHref} alt="AMSSRN" class="h-12 w-auto" />
   </a>
 </header>
    <slot />
</body>
</html>
